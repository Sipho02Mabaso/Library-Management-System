# IDE
.kilo/
.vscode/

# 1. Ignore EVERYTHING inside the server directory
server/*

# 2. Un-ignore the Controllers folder so Git can look inside it
!server/Controllers/
!server/Core/

# 3. Ignore the specific Controllers you DO NOT want on GitHub

server/Core/Enums/
server/Core/interfaces/

server/Core/Entities/RoomBookings.cs
server/Core/Entities/SavedBook.cs
server/Core/Entities/Session.cs
server/Core/Entities/SessionBooking.cs
server/Core/Entities/SystemSetting.cs
server/Core/Entities/User.cs





# 4. Un-ignore your root server files
!server/Program.cs
!server/server.http
!server/server.csproj

